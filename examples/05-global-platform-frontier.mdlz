      },
      "selected": false,
      "data": {
        "label": "Negative-coordinate export",
        "text": "Export the entire diagram including annotations, notes and areas. The notes and annotations outside the class envelope must remain present and unclipped.",
        "visibility": {
          "conceptual": true,
          "logical": false,
          "physical": false
        },
