    {
      "id": "note-0364",
      "type": "note",
      "position": {
        "x": -3100,
        "y": -2100
      },
      "selected": false,
      "data": {
        "label": "READABILITY FRONTIER — keep this difficult",
        "text": "This is an end-goal fixture, not a claim of current visual correctness. Preserve all connections and complete labels. At useful local zoom, every line should be traceable and every annotation readable.\n\nPerson intentionally has EIGHT reflexive associations: this exceeds the current four-loop creation limit. Nested loop sizes are explicit. The file remains valid v2.",
        "visibility": {
          "conceptual": true,
          "logical": false,
          "physical": false
        },
        "viewPositions": {
          "conceptual": {
            "x": -3100,
            "y": -2100
          },
          "logical": {
            "x": -3100,
            "y": -2100
          },
          "physical": {
            "x": -3100,
            "y": -2100
          }
        }
      }
    },
    {
      "id": "note-0365",
      "type": "note",
      "position": {
        "x": 4200,
        "y": -1750
      },
      "selected": false,
      "data": {
        "label": "Long-label acceptance target",
        "text": "Do not pass by truncating names, hiding roles, removing multiplicities, dropping edges, shrinking text or deleting notes. Compare light and dark canvas; PNG exports currently use a light canvas.",
        "visibility": {
          "conceptual": true,
          "logical": false,
          "physical": false
        },
        "viewPositions": {
          "conceptual": {
            "x": 4200,
