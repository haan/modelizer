      "type": "note",
      "position": {
        "x": 4200,
        "y": 3100
      },
      "selected": false,
      "data": {
        "label": "Manual and transient smoke tests",
        "text": "Edit one manual route; undo once. Draw and erase one stroke; undo once. Use the laser, save and reopen: laser trails must never be saved. The fixture deliberately contains no persistent laser stroke.",
        "visibility": {
          "conceptual": true,
          "logical": false,
          "physical": false
